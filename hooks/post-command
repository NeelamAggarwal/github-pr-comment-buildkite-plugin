#!/usr/bin/env bash
# Post a comment to a GitHub pull request.
#
# Runs as a post-command hook so it executes at job runtime (after the step's
# own commands), with the live build environment available. This matters: the
# comment body and PR/repo values are read from the runtime environment, not
# from pipeline-upload-time interpolation, so values produced by the build
# (or set in a pipeline `env:` block) resolve correctly.
#
# The PR can live in a different repository than the one being built, which is
# why the target repo and PR number are configurable rather than derived solely
# from BUILDKITE_PULL_REQUEST_REPO.
#
# Posting behavior:
#   - sticky: false (default) -> always create a new comment.
#   - sticky: true -> maintain a single comment per key (found via a hidden
#       marker). The first run posts `comment`/`comment-path`. `sticky-strategy`
#       controls later runs:
#         * edit-append (default): edit in place; if `reply-path` is set, append
#             it below the existing body, keeping the original header and all
#             prior replies (a running log). Silent (no GitHub notification).
#         * edit-latest: edit in place; if `reply-path` is set, keep the header
#             but show only the newest reply. Silent.
#         * replace: post a fresh comment and delete the previous one, so only
#             the latest remains and every run notifies. `reply-path` is unused.

set -euo pipefail

comment="${BUILDKITE_PLUGIN_GITHUB_PR_COMMENT_COMMENT:-}"
comment_path="${BUILDKITE_PLUGIN_GITHUB_PR_COMMENT_COMMENT_PATH:-}"
reply_path="${BUILDKITE_PLUGIN_GITHUB_PR_COMMENT_REPLY_PATH:-}"
pr="${BUILDKITE_PLUGIN_GITHUB_PR_COMMENT_PR:-${BUILDKITE_PULL_REQUEST:-}}"
repo="${BUILDKITE_PLUGIN_GITHUB_PR_COMMENT_REPO:-${BUILDKITE_PULL_REQUEST_REPO:-}}"
token_env="${BUILDKITE_PLUGIN_GITHUB_PR_COMMENT_TOKEN_ENV:-GITHUB_TOKEN}"
expand="${BUILDKITE_PLUGIN_GITHUB_PR_COMMENT_EXPAND:-false}"
sticky="${BUILDKITE_PLUGIN_GITHUB_PR_COMMENT_STICKY:-false}"
sticky_key="${BUILDKITE_PLUGIN_GITHUB_PR_COMMENT_STICKY_KEY:-default}"
strategy="${BUILDKITE_PLUGIN_GITHUB_PR_COMMENT_STICKY_STRATEGY:-edit-append}"

log() { echo "github-pr-comment: $*" >&2; }

# Skip on non-PR builds. Buildkite sets BUILDKITE_PULL_REQUEST to "false".
if [[ -z "$pr" || "$pr" == "false" ]]; then
  log "no pull request number; skipping."
  exit 0
fi

# Resolve owner/name from "owner/name" or a git/https URL.
owner_repo=""
if [[ "$repo" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]]; then
  owner_repo="$repo"
elif [[ "$repo" =~ ^(https|git)(://|@)([^/:]+)[/:]([^/]+)/(.+)$ ]]; then
  owner_repo="${BASH_REMATCH[4]}/${BASH_REMATCH[5]%.git}"
fi
if [[ -z "$owner_repo" ]]; then
  log "could not parse owner/name from repo '${repo}'; skipping."
  exit 0
fi

# Resolve token from the configured env var; non-fatal if missing so that a
# misconfigured agent never fails an otherwise-green build.
token="${!token_env:-}"
if [[ -z "$token" ]]; then
  log "\$${token_env} is not set; skipping."
  exit 0
fi

if [[ "$strategy" != "edit-append" && "$strategy" != "edit-latest" && "$strategy" != "replace" ]]; then
  log "WARN unknown sticky-strategy '${strategy}'; defaulting to 'edit-append'."
  strategy="edit-append"
fi

# expand_body reads a body on stdin and, when expand=true, resolves $VAR
# references against the runtime environment via envsubst.
expand_body() {
  if [[ "$expand" == "true" ]] && command -v envsubst >/dev/null 2>&1; then
    envsubst
  else
    cat
  fi
}
if [[ "$expand" == "true" ]] && ! command -v envsubst >/dev/null 2>&1; then
  log "WARN expand=true but envsubst is unavailable; posting bodies unexpanded."
fi

# Resolve the comment body from comment-path (read at runtime) or comment.
body=""
if [[ -n "$comment_path" ]]; then
  if [[ ! -f "$comment_path" ]]; then
    log "comment-path '${comment_path}' not found; skipping."
    exit 0
  fi
  body="$(expand_body <"$comment_path")"
elif [[ -n "$comment" ]]; then
  body="$(expand_body <<<"$comment")"
else
  log "one of 'comment' or 'comment-path' is required; skipping."
  exit 0
fi

# Resolve the optional reply body (used only by sticky edit updates).
reply_body=""
if [[ -n "$reply_path" ]]; then
  if [[ -f "$reply_path" ]]; then
    reply_body="$(expand_body <"$reply_path")"
  else
    log "WARN reply-path '${reply_path}' not found; ignoring."
  fi
fi

# Pick a JSON tool once. Prefer jq, fall back to python3 so the hook works on
# agents that lack jq. If neither is available, skip rather than risk emitting
# malformed JSON or failing the build.
json_tool=""
if command -v jq >/dev/null 2>&1; then
  json_tool="jq"
elif command -v python3 >/dev/null 2>&1; then
  json_tool="python3"
else
  log "WARN neither jq nor python3 is available to encode JSON; skipping."
  exit 0
fi

api="https://api.github.com/repos/${owner_repo}"
auth_headers=(
  -H "Authorization: Bearer ${token}"
  -H "Accept: application/vnd.github+json"
  -H "X-GitHub-Api-Version: 2022-11-28"
)

# For sticky comments, embed a hidden HTML-comment marker so future runs can
# find the same comment. The marker renders invisibly on GitHub.
marker=""
if [[ "$sticky" == "true" ]]; then
  marker="<!-- github-pr-comment:sticky:${sticky_key} -->"
  body="${body}"$'\n\n'"${marker}"
fi

# json_body <string> writes a GitHub API {"body": ...} payload to the payload
# file, using whichever JSON tool is available.
json_body() {
  if [[ "$json_tool" == "jq" ]]; then
    jq -n --arg body "$1" '{body: $body}' >"$payload_file"
  else
    GHPC_BODY="$1" python3 -c 'import json, os, sys; sys.stdout.write(json.dumps({"body": os.environ["GHPC_BODY"]}))' >"$payload_file"
  fi
}

# read_json_body reads an API comment object on stdin and prints its .body.
read_json_body() {
  if [[ "$json_tool" == "jq" ]]; then
    jq -r '.body // empty'
  else
    python3 -c 'import json,sys
try:
    sys.stdout.write(json.load(sys.stdin).get("body") or "")
except Exception:
    pass'
  fi
}

# Find the id of an existing sticky comment carrying the marker, if any.
# Pages through issue comments (up to 10 pages of 100). Best-effort: any error
# returns empty so we fall back to creating a new comment.
find_sticky_comment_id() {
  local m="$1" page=1 resp id len
  while ((page <= 10)); do
    resp="$(curl -sS "${auth_headers[@]}" "${api}/issues/${pr}/comments?per_page=100&page=${page}")" || return 0
    if [[ "$json_tool" == "jq" ]]; then
      id="$(jq -r --arg m "$m" '[.[] | select(.body != null and (.body | contains($m)))][0].id // empty' <<<"$resp" 2>/dev/null || true)"
      len="$(jq 'length' <<<"$resp" 2>/dev/null || echo 0)"
    else
      id="$(GHPC_MARKER="$m" python3 -c 'import json,os,sys
m=os.environ["GHPC_MARKER"]
try:
    data=json.load(sys.stdin)
except Exception:
    data=[]
print(next((str(c["id"]) for c in data if isinstance(c,dict) and isinstance(c.get("body"),str) and m in c["body"]), ""))' <<<"$resp" 2>/dev/null || true)"
      len="$(python3 -c 'import json,sys
try:
    print(len(json.load(sys.stdin)))
except Exception:
    print(0)' <<<"$resp" 2>/dev/null || echo 0)"
    fi
    if [[ -n "${id:-}" ]]; then
      echo "$id"
      return 0
    fi
    [[ "${len:-0}" -lt 100 ]] && break
    page=$((page + 1))
  done
  return 0
}

# get_comment_body <id> prints the current body of an existing comment.
get_comment_body() {
  local id="$1" resp
  resp="$(curl -sS "${auth_headers[@]}" "${api}/issues/comments/${id}")" || return 1
  read_json_body <<<"$resp"
}

response_file="$(mktemp)"
payload_file="$(mktemp)"
trap 'rm -f "$response_file" "$payload_file"' EXIT

# send <method> <url> performs the request, capturing the HTTP status in the
# global http_code and the response body in response_file.
http_code=""
send() {
  http_code="$(
    curl -sS -o "$response_file" -w '%{http_code}' \
      -X "$1" \
      "${auth_headers[@]}" \
      -H "Content-Type: application/json" \
      --data-binary @"$payload_file" \
      "$2" || true
  )"
}

succeeded() { [[ "$http_code" =~ ^2 ]]; }
warn_failure() {
  log "WARN $1 failed (HTTP ${http_code:-000}); not failing the build."
  cat "$response_file" >&2 || true
}

# Non-sticky: always create a new comment.
if [[ "$sticky" != "true" ]]; then
  json_body "$body"
  log "posting comment to ${owner_repo}#${pr}"
  send POST "${api}/issues/${pr}/comments"
  if succeeded; then log "posted comment to ${owner_repo}#${pr}."; else warn_failure "POST"; fi
  exit 0
fi

comment_id="$(find_sticky_comment_id "$marker")"

if [[ "$strategy" == "replace" ]]; then
  # Post a fresh comment, then delete the previous one. Post-first so the PR is
  # never momentarily without the comment; the delete is best-effort.
  json_body "$body"
  log "posting comment to ${owner_repo}#${pr} (replace)"
  send POST "${api}/issues/${pr}/comments"
  if succeeded; then
    log "posted comment to ${owner_repo}#${pr}."
    if [[ -n "$comment_id" ]]; then
      del_code="$(curl -sS -o /dev/null -w '%{http_code}' -X DELETE "${auth_headers[@]}" "${api}/issues/comments/${comment_id}" || true)"
      if [[ "$del_code" =~ ^2 ]]; then
        log "deleted previous comment ${comment_id}."
      else
        log "WARN failed to delete previous comment ${comment_id} (HTTP ${del_code:-000})."
      fi
    fi
  else
    warn_failure "POST"
  fi
  exit 0
fi

# strategy == edit-append | edit-latest
if [[ -z "$comment_id" ]]; then
  # First run for this sticky key: create the header comment.
  json_body "$body"
  log "posting comment to ${owner_repo}#${pr}"
  send POST "${api}/issues/${pr}/comments"
  if succeeded; then log "posted comment to ${owner_repo}#${pr}."; else warn_failure "POST"; fi
  exit 0
fi

# Subsequent run.
if [[ -z "$reply_body" ]]; then
  # No reply configured: edit the header in place.
  json_body "$body"
  log "editing comment ${comment_id} on ${owner_repo}#${pr}"
elif [[ "$strategy" == "edit-latest" ]]; then
  # Keep the header, show only the newest reply. Recompose from the header body
  # (which already carries the marker), no read of the existing comment needed.
  json_body "${body}"$'\n\n'"${reply_body}"
  log "updating comment ${comment_id} with latest reply on ${owner_repo}#${pr}"
else
  # edit-append: append the reply below the existing body, keeping the header and
  # all prior replies. Fall back to editing the header if the read fails.
  existing="$(get_comment_body "$comment_id" || true)"
  if [[ -z "$existing" ]]; then
    log "WARN could not read existing comment ${comment_id}; editing header instead."
    json_body "$body"
  else
    json_body "${existing}"$'\n\n'"${reply_body}"
    log "appending reply to comment ${comment_id} on ${owner_repo}#${pr}"
  fi
fi

send PATCH "${api}/issues/comments/${comment_id}"
if succeeded; then log "updated comment ${comment_id} on ${owner_repo}#${pr}."; else warn_failure "PATCH"; fi
